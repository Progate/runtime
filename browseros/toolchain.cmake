# BrowserOS（wasm32-browseros-linux-musl）向けの CMake の道具。
# CC・CXX・AR・RANLIB は環境変数 BROWSEROS_CC などで、世界の sysroot は BROWSER_SYSROOT で渡す（→ browseros/build.mjs）
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(CMAKE_C_COMPILER $ENV{BROWSEROS_CC})
set(CMAKE_CXX_COMPILER $ENV{BROWSEROS_CXX})
set(CMAKE_AR $ENV{BROWSEROS_AR} CACHE FILEPATH "")
set(CMAKE_RANLIB $ENV{BROWSEROS_RANLIB} CACHE FILEPATH "")
set(CMAKE_SYSROOT $ENV{BROWSER_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
